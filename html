<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Product Ticker</title>
<style>
  body {
    margin: 0;
    background: transparent;
    font-family: Arial, sans-serif;
    overflow: hidden;
  }
  .ticker-wrap {
    width: 100%;
    height: 80px;
    background: rgba(0,0,0,0.7);
    color: white;
    overflow: hidden;
    position: relative;
    display: flex;
    align-items: center;
  }
  .ticker {
    display: flex;
    white-space: nowrap;
    animation: scroll 40s linear infinite;
  }
  .item {
    padding: 0 40px;
    font-size: 22px;
    font-weight: bold;
  }
  .item span.price {
    color: #4ade80;
    margin-left: 12px;
  }
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>
</head>
<body>
<div class="ticker-wrap">
  <div class="ticker" id="ticker"></div>
</div>

<script>
  // PASTE YOUR PUBLISHED CSV URL HERE
  const CSV_URL = 'https://docs.google.com/spreadsheets/d/e/YOUR_PUBLISHED_URL/pub?output=csv';

  async function loadProducts() {
    try {
      const res = await fetch(CSV_URL);
      const text = await res.text();
      const rows = text.trim().split('\n').slice(1); // skip header

      const ticker = document.getElementById('ticker');
      let html = '';

      rows.forEach(row => {
        const cols = row.split(',');
        const name = cols[0]?.replace(/"/g, '').trim() || '';
        const price = cols[1]?.replace(/"/g, '').trim() || '';
        if (name) {
          html += `<div class="item">${name}${price ? `<span class="price">${price}</span>` : ''}</div>`;
        }
      });

      // Duplicate for seamless loop
      ticker.innerHTML = html + html;
    } catch (e) {
      document.getElementById('ticker').innerHTML = '<div class="item">Error loading products</div>';
    }
  }

  loadProducts();
  // Refresh every 2 minutes
  setInterval(loadProducts, 120000);
</script>
</body>
</html>
